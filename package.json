{
  "name": "tennis-rank",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "dev:vite": "vite",
    "dev:d1": "wrangler pages dev dist --d1=webapp-production --local --ip 0.0.0.0 --port 3000",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --outfile=dist/server.js",
    "start": "node dist/server.js",
    "deploy:cf": "vite build && wrangler pages deploy dist --project-name tennis-rank",
    "db:migrate:local": "wrangler d1 migrations apply webapp-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply webapp-production",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.15.0",
    "@hono/node-server": "^1.13.8",
    "dotenv": "^16.4.7",
    "hono": "^4.12.12",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260415.1",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
