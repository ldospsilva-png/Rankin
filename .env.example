# ============================================================
// VARIÁVEIS DE AMBIENTE - TÊNISRANK (GCP / LOCAL)
// ============================================================

# Porta do Servidor Web (Cloud Run define automaticamente via $PORT)
PORT=3000

# Segredo de Assinatura do JWT
JWT_SECRET=sua-chave-secreta-jwt-super-segura-2026

# String de Conexão com o Banco de Dados PostgreSQL (GCP Cloud SQL / Local)
# Exemplo local: postgresql://postgres:postgres@localhost:5432/tenis_rank_db
# Exemplo Cloud SQL: postgresql://tenis_user:senha_forte@/tenis_rank_db?host=/cloudsql/PROJETO:REGION:INSTANCIA
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tenis_rank_db

# Nome do Bucket do Google Cloud Storage (GCS) para fotos e logos
GCS_BUCKET_NAME=tenis-rank-media-bucket
